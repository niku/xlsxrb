    # @return [void]
    # : (?core: Hash[Symbol, String | Integer | Time]?, ?app: Hash[Symbol, String | Integer | Time]?) -> void
    def properties: (?core: Hash[Symbol, String | Integer | Time]?, ?app: Hash[Symbol, String | Integer | Time]?) -> void

    # Add a custom document property.
    #
    # @param name [String] The property name.
    # @param value [String, Integer, Float, Boolean, Time] The property value.
    # @param type [Symbol] The type of property (:string, :number, :bool, :date).
    # @return [void]
    # : (String name, String | Integer | Float | bool | Time value, ?type: ::Symbol) -> void
    def custom_property: (String name, String | Integer | Float | bool | Time value, ?type: ::Symbol) -> void

    # : () -> untyped
    def close: () -> untyped

    # Explicitly remove any remaining tempfiles. Called via ensure block.
    # : () -> void
    def cleanup!: () -> void

    private

    # : (untyped range) -> untyped
    def absolute_range: (untyped range) -> untyped

    # : (untyped names, untyped sheets) -> untyped
    def resolve_defined_names: (untyped names, untyped sheets) -> untyped

    # : () -> (nil | untyped)
    def flush_current_sheet: () -> (nil | untyped)
  end

  private def self.build_worksheet: (untyped name, untyped sheet_xml, untyped shared_strings, untyped _styles) -> untyped

  private def self.build_row_from_raw: (untyped raw_row) -> untyped

  private def self.build_raw_cell: (untyped cell, untyped sst, untyped sst_index) -> untyped

  private def self.build_row_attrs: (untyped row) -> untyped

  # Builds a raw cell hash from a value for streaming writes.
  # @api public
  # : (untyped row_index, untyped col_index, untyped value, untyped sst, untyped sst_index) -> untyped
  def self.build_raw_cell_from_value: (untyped row_index, untyped col_index, untyped value, untyped sst, untyped sst_index) -> untyped
end
