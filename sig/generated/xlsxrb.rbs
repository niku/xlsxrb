  # Represents a sheet being streamed sequentially from an XLSX file.
  #
  # @example Iterate rows and cells in streaming mode (O(1) memory)
  #   Xlsxrb.foreach("large_data.xlsx") do |sheet|
  #     puts "Processing sheet: #{sheet.name}"
