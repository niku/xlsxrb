    # @return [Array<untyped>]
    # @api public
    # : () -> Array[untyped]
    def row_breaks: () -> Array[untyped]

    # Returns explicit column page breaks for this worksheet.
    #
    # @return [Array<untyped>]
    # @api public
    # : () -> Array[untyped]
    def col_breaks: () -> Array[untyped]

    # Returns protected ranges defined for this worksheet.
    #
    # @return [Array<Hash[Symbol, untyped]>]
    # @api public
    # : () -> Array[Hash[Symbol, untyped]]
    def protected_ranges: () -> Array[Hash[Symbol, untyped]]

    # Returns cell watch cell references defined for this worksheet.
    #
    # @return [Array<String>]
    # @api public
    # : () -> Array[String]
    def cell_watches: () -> Array[String]

    # Returns ignored error rules defined for this worksheet.
    #
    # @return [Array<Hash[Symbol, untyped]>]
    # @api public
    # : () -> Array[Hash[Symbol, untyped]]
    def ignored_errors: () -> Array[Hash[Symbol, untyped]]

    # Returns phonetic properties defined for this worksheet, or nil.
    #
    # @return [Hash[Symbol, untyped], nil]
    # @api public
    # : () -> Hash[Symbol, untyped]?
    def phonetic_properties: () -> Hash[Symbol, untyped]?

    # @deprecated Use {#phonetic_properties} instead. Will be removed in 0.2.0.
    alias phonetic_pr phonetic_properties

    # Returns the background image configured for this worksheet, or nil.
    #
    # @return [Hash[Symbol, untyped], nil]
    # @api public
    # : () -> Hash[Symbol, untyped]?
    def background_image: () -> Hash[Symbol, untyped]?

    # @deprecated Use {#background_image} instead. Will be removed in 0.2.0.
    alias background_picture background_image

    # @deprecated Use {#background_image} instead. Will be removed in 0.2.0.
    alias picture background_image

    # Closes any underlying reader resources.
    # : () -> void
    def close: () -> void

    private

    # : () -> Hash[Symbol, untyped]
    def sheet_view_data: () -> Hash[Symbol, untyped]

    # : () -> Hash[Symbol, untyped]
    def print_page_data: () -> Hash[Symbol, untyped]

    # : () -> String
    def raw_sheet_xml: () -> String

    # Returns 1-based bounds [first_row, first_col, last_row, last_col] from dimension ref.
    # : () -> Array[Integer]?
    def dimension_bounds: () -> Array[Integer]?

    # Extracts dimension reference from XML source lazily without parsing the entire file.
    # : () -> String?
    def extract_dimension: () -> String?
  end
end
