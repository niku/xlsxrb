    # : (?untyped val) -> untyped
    def time_period: (?untyped val) -> untyped

    # : (untyped val) -> untyped
    def time_period=: (untyped val) -> untyped

    # : (?untyped val) -> untyped
    def color_scale: (?untyped val) -> untyped

    # : (untyped val) -> untyped
    def color_scale=: (untyped val) -> untyped

    # : (?untyped val) -> untyped
    def data_bar: (?untyped val) -> untyped

    # : (untyped val) -> untyped
    def data_bar=: (untyped val) -> untyped

    # : (?untyped val) -> untyped
    def icon_set: (?untyped val) -> untyped

    # : (untyped val) -> untyped
    def icon_set=: (untyped val) -> untyped

    # : (?untyped val) -> untyped
    def dxf: (?untyped val) -> untyped

    # : (untyped val) -> untyped
    def dxf=: (untyped val) -> untyped

    # : (?Integer? val) -> Integer?
    def format_id: (?Integer? val) -> Integer?

    # : (Integer val) -> Integer
    def format_id=: (Integer val) -> Integer

    # : () -> Hash[Symbol, untyped]
    def to_h: () -> Hash[Symbol, untyped]
  end
end
