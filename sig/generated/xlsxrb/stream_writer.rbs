      def sheet_calc_pr: (?Hash[Symbol, untyped]? spec, ?full_calc_on_load: bool?, **untyped opts) -> Hash[Symbol, untyped]?

      alias sheet_calc_pr= sheet_calc_pr

      alias calc_pr sheet_calc_pr

      alias calc_pr= sheet_calc_pr
