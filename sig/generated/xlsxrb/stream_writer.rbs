      def protected_range: (String name, String sqref, ?password: String?, **untyped opts) -> void

      # Adds a cell watch to the sheet.
      #
      # @param ref [String] Cell reference (e.g. "A1").
      # @return [void]
      # @api public
      # : (String ref) -> void
