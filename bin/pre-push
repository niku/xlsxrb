#!/usr/bin/env bash
set -euo pipefail

# Git pre-push hook passes refs on stdin; redirect stdin to /dev/null
# to prevent child test runners from hanging on open pipes.
exec < /dev/null

# Parse arguments and environment options
RUN_EXTENDED=0
FORCE_CHECK=0
SINCE_REF=""

for arg in "$@"; do
  case "$arg" in
    --all) RUN_EXTENDED=1 ;;
    --force) FORCE_CHECK=1; RUN_EXTENDED=1 ;;
    --last|--since-last) SINCE_REF="HEAD~1"; RUN_EXTENDED=1 ;;
    --since=*) SINCE_REF="${arg#*=}"; RUN_EXTENDED=1 ;;
  esac
done

if [ "${FULL_PRE_PUSH:-0}" = "1" ]; then
  RUN_EXTENDED=1
fi
if [ "${FORCE_PRE_PUSH:-0}" = "1" ]; then
  FORCE_CHECK=1
  RUN_EXTENDED=1
fi

echo "Running pre-push checks..."

echo "1/4 Running RuboCop..."
bundle exec rubocop

echo "2/4 Running Steep Type Check..."
bundle exec rake typecheck

echo "3/4 Verifying RBS is in sync..."
bundle exec rake sig
git diff --exit-code sig/

echo "4/4 Running Unit & Contract Tests..."
bundle exec rake test:unit test:contract

# Extended checks (RBS runtime validation & Mutation testing)
if [ "$RUN_EXTENDED" = "1" ]; then
  get_changed_files() {
    local base_ref
    if [ -n "$SINCE_REF" ]; then
      base_ref="$SINCE_REF"
    elif git rev-parse --verify origin/main >/dev/null 2>&1; then
      base_ref="$(git merge-base origin/main HEAD 2>/dev/null || echo "HEAD~1")"
    else
      base_ref="HEAD~1"
    fi

    {
      git diff --name-only "$base_ref" HEAD 2>/dev/null || true
      git diff --name-only HEAD 2>/dev/null || true
      git diff --name-only --cached 2>/dev/null || true
    } | sort -u
  }

  CHANGED_FILES=""
  if [ "$FORCE_CHECK" = "0" ]; then
    CHANGED_FILES="$(get_changed_files)"
  fi

  has_pure_logic_changes() {
    [ "$FORCE_CHECK" = "1" ] && return 0
    local pattern='^(lib/xlsxrb/(elements/|ooxml/(utils|zip_generator|cfb|xml_builder)\.rb|stream_row\.rb|dsl_helpers\.rb)|test/(xlsxrb/(elements|ooxml|ooxml/utils|ooxml/crypto|ooxml/cfb|stream_row|style_builder|dsl_helpers)_test\.rb|zip_generator_test\.rb)|Rakefile|\.mutant\.yml)'
    echo "$CHANGED_FILES" | grep -Eq "$pattern"
  }

  has_code_or_sig_changes() {
    [ "$FORCE_CHECK" = "1" ] && return 0
    local pattern='^(lib/|sig/|test/|Rakefile)'
    echo "$CHANGED_FILES" | grep -Eq "$pattern"
  }

  if has_code_or_sig_changes; then
    echo "5/6 Running RBS Runtime Type Validation (single worker to avoid hook deadlock)..."
    TEST_WORKERS=1 bundle exec rake test:rbs
  else
    echo "5/6 Skipping RBS Runtime Type Validation (no code or type signature changes)..."
  fi

  if has_pure_logic_changes; then
    echo "6/6 Running Mutation Tests (Pure Logic)..."
    bundle exec rake mutant:pure
  else
    echo "6/6 Skipping Mutation Tests (no pure logic changes detected)..."
  fi
fi

echo "All pre-push checks passed!"
